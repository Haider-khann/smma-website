// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  CLIENT
  ADMIN
  SMM
}

enum ProjectStatus {
  PENDING
  ACTIVE
  PAUSED
  COMPLETED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  PROPOSAL_SENT
  ACCEPTED
  CHANGES_REQUESTED
}

enum ContentStatus {
  DRAFT
  INTERNAL_REVIEW
  CLIENT_REVIEW
  APPROVED
  REVISION_REQUESTED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
}

// ─────────────────────────────────────────────
// AUTH & USERS
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String?
  phone         String?
  role          Role      @default(CLIENT)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  clientProfile      ClientProfile?
  projectsOwned      Project[]       @relation("ClientProjects")
  projectsManaged    Project[]       @relation("SMMProjects")
  tasksAssigned      Task[]          @relation("AssignedTasks")
  messagesSent       Message[]       @relation("SentMessages")
  messagesReceived   Message[]       @relation("ReceivedMessages")
  notifications      Notification[]
  reviews            Review[]
  supportTickets     SupportTicket[]
  invoices           Invoice[]
  proposalsCreated   Proposal[]      @relation("ProposalsCreated")
  reports            Report[]
  campaigns          Campaign[]
  contents           Content[]
  files              File[]
  quoteRequests      QuoteRequest[]
  timesheets         Timesheet[]
  invitationsCreated Invitation[]    @relation("InvitationsCreated")

  @@index([email])
}

model ClientProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  businessName        String?
  businessCategory    String?
  businessDescription String?
  businessLocation    String?
  targetAudience      String?
  businessLogo        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// SERVICES & PACKAGES
// ─────────────────────────────────────────────

model Service {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Float
  duration    Int
  image       String?
  active      Boolean  @default(true)
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  packageServices PackageService[]
  quoteServices   QuoteService[]
  projectServices ProjectService[]
}

model Package {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  duration    Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  features        PackageFeature[]
  packageServices PackageService[]
}

model PackageFeature {
  id        String @id @default(cuid())
  packageId String
  feature   String

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
}

model PackageService {
  id        String @id @default(cuid())
  packageId String
  serviceId String

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([packageId, serviceId])
}

// ─────────────────────────────────────────────
// QUOTE REQUESTS & PROPOSALS
// ─────────────────────────────────────────────

model QuoteRequest {
  id            String        @id @default(cuid())
  clientId      String
  title         String
  description   String
  budget        Float?
  deadline      DateTime?
  status        RequestStatus @default(PENDING)
  attachmentUrl String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  client    User           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  services  QuoteService[]
  proposals Proposal[]
  project   Project?
}

model QuoteService {
  id             String @id @default(cuid())
  quoteRequestId String
  serviceId      String

  quoteRequest QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([quoteRequestId, serviceId])
}

model Proposal {
  id             String        @id @default(cuid())
  quoteRequestId String
  createdById    String
  price          Float
  duration       Int
  description    String
  status         RequestStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  quoteRequest QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("ProposalsCreated", fields: [createdById], references: [id])
}

// ─────────────────────────────────────────────
// PROJECTS & TASKS
// ─────────────────────────────────────────────

model Project {
  id             String        @id @default(cuid())
  title          String
  description    String?
  clientId       String
  smmId          String?
  quoteRequestId String?       @unique
  status         ProjectStatus @default(PENDING)
  startDate      DateTime?
  deadline       DateTime?
  progress       Int           @default(0)
  currentStage   String?
  objectives     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  client       User             @relation("ClientProjects", fields: [clientId], references: [id], onDelete: Cascade)
  smm          User?            @relation("SMMProjects", fields: [smmId], references: [id])
  quoteRequest QuoteRequest?    @relation(fields: [quoteRequestId], references: [id])
  tasks        Task[]
  files        File[]
  campaigns    Campaign[]
  invoices     Invoice[]
  reports      Report[]
  services     ProjectService[]
  contents     Content[]
  timesheets   Timesheet[]
}

model ProjectService {
  id        String @id @default(cuid())
  projectId String
  serviceId String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([projectId, serviceId])
}

model Task {
  id          String    @id @default(cuid())
  projectId   String
  assigneeId  String?
  title       String
  description String?
  status      String    @default("PENDING")
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?   @relation("AssignedTasks", fields: [assigneeId], references: [id])
}

// ─────────────────────────────────────────────
// CAMPAIGNS & CONTENT
// ─────────────────────────────────────────────

model Campaign {
  id             String         @id @default(cuid())
  projectId      String
  createdById    String
  name           String
  objective      String?
  platform       String?
  targetAudience String?
  budget         Float?
  startDate      DateTime?
  endDate        DateTime?
  status         CampaignStatus @default(DRAFT)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id])
  contents  Content[]
}

model Content {
  id          String        @id @default(cuid())
  campaignId  String?
  projectId   String
  createdById String
  title       String?
  caption     String?
  hashtags    String?
  platform    String?
  mediaUrl    String?
  scheduledAt DateTime?
  status      ContentStatus @default(DRAFT)
  feedback    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  campaign  Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id])
}

// ─────────────────────────────────────────────
// MESSAGING
// ─────────────────────────────────────────────

model Message {
  id            String    @id @default(cuid())
  senderId      String
  receiverId    String
  projectId     String?
  body          String
  attachmentUrl String?
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// FILES
// ─────────────────────────────────────────────

model File {
  id         String   @id @default(cuid())
  projectId  String?
  uploaderId String
  name       String
  url        String
  size       Int?
  mimeType   String?
  createdAt  DateTime @default(now())

  project  Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader User     @relation(fields: [uploaderId], references: [id])
}

// ─────────────────────────────────────────────
// INVOICES
// ─────────────────────────────────────────────

model Invoice {
  id        String        @id @default(cuid())
  clientId  String
  projectId String?
  amount    Float
  issueDate DateTime      @default(now())
  dueDate   DateTime
  status    InvoiceStatus @default(PENDING)
  items     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  client  User     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

// ─────────────────────────────────────────────
// REPORTS & REVIEWS
// ─────────────────────────────────────────────

model Report {
  id             String   @id @default(cuid())
  projectId      String
  createdById    String
  month          String
  postCount      Int      @default(0)
  followerGrowth Int      @default(0)
  engagement     Int      @default(0)
  notes          String?
  createdAt      DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id])
}

model Review {
  id        String   @id @default(cuid())
  clientId  String
  rating    Int
  comment   String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  client User @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// PORTFOLIO & FAQ
// ─────────────────────────────────────────────

model Portfolio {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String
  image       String
  projectDate DateTime
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FAQ {
  id       String @id @default(cuid())
  question String
  answer   String
  order    Int    @default(0)
}

// ─────────────────────────────────────────────
// SUPPORT & NOTIFICATIONS
// ─────────────────────────────────────────────

model SupportTicket {
  id        String   @id @default(cuid())
  clientId  String
  subject   String
  body      String
  status    String   @default("OPEN")
  response  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client User @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// TIMESHEETS
// ─────────────────────────────────────────────

model Timesheet {
  id          String   @id @default(cuid())
  userId      String
  projectId   String?
  hours       Float
  date        DateTime
  description String?
  createdAt   DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
}

// ─────────────────────────────────────────────
// INVITATIONS
// ─────────────────────────────────────────────

model Invitation {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String
  token       String    @unique
  role        Role      @default(SMM)
  expiresAt   DateTime
  accepted    Boolean   @default(false)
  acceptedAt  DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  createdBy User @relation("InvitationsCreated", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([token])
}
